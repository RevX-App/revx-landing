---
/** Two-tone brand mark, recreated from the app's RevXLogo. */
interface Props {
  size?: string;
}

const { size = '2rem' } = Astro.props;
---

<span class="wordmark" style={`--size:${size}`} aria-label="RevX">
  <span class="rev" aria-hidden="true">Rev</span><span class="x" aria-hidden="true">X</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--font-body);
    font-size: var(--size);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .rev {
    font-weight: 700;
    color: var(--heading);
  }

  .x {
    font-weight: 800;
    /* Matches the app's RevXLogo: all ink on light, lime X on dark. */
    color: light-dark(var(--on-accent), var(--accent));
  }
</style>
